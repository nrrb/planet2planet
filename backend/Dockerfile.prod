FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
# Runtime dependencies only: no pytest or ruff on the server.
RUN pip install --no-cache-dir .
COPY . .
RUN SECRET_KEY=build ALLOWED_HOSTS=localhost DJANGO_SETTINGS_MODULE=config.settings.prod \
    python manage.py collectstatic --noinput
RUN useradd --system --create-home app
USER app
CMD ["gunicorn", "config.wsgi", "--bind", "0.0.0.0:8000", "--workers", "2", "--access-logfile", "-"]
